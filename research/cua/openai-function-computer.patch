+_FUNCTION_ACTION_FIELDS = {
+    "click": {"x", "y", "button"},
+    "double_click": {"x", "y"},
+    "right_click": {"x", "y"},
+    "type": {"text"},
+    "keypress": {"keys"},
+    "scroll": {"x", "y", "scroll_x", "scroll_y"},
+    "move": {"x", "y"},
+    "drag": {"start_x", "start_y", "end_x", "end_y"},
+    "screenshot": set(),
+    "wait": set(),
+    "terminate": {"status"},
+}
+
+
+def _function_computer_output(item: Dict[str, Any]) -> Dict[str, Any]:
+    """Normalize a computer function's flat arguments before Cua dispatch."""
+    try:
+        arguments = json.loads(item["arguments"])
+    except (KeyError, TypeError, ValueError) as exc:
+        raise ValueError("Malformed OpenAI computer arguments") from exc
+    if not isinstance(arguments, dict):
+        raise ValueError("Computer arguments must be a JSON object")
+    name = arguments.get("action")
+    if not isinstance(name, str) or name not in _FUNCTION_ACTION_FIELDS:
+        raise ValueError("Unknown OpenAI computer action")
+    if set(arguments) - {"action"}.union(*_FUNCTION_ACTION_FIELDS.values()):
+        raise ValueError("Unknown OpenAI computer fields")
+    # The flat tool schema may populate inactive fields with non-null defaults.
+    action = {
+        key: value for key, value in arguments.items() if key in _FUNCTION_ACTION_FIELDS[name]
+    }
+    action["type"] = name
+    coordinates = ("start_x", "start_y", "end_x", "end_y") if name == "drag" else ("x", "y")
+    if name in {"click", "double_click", "right_click", "scroll", "move", "drag"}:
+        if any(type(action.get(key)) is not int for key in coordinates):
+            raise ValueError("Computer coordinates must be integers")
+    if name == "type" and not isinstance(action.get("text"), str):
+        raise ValueError("Computer text must be a string")
+    if name == "keypress":
+        keys = action.get("keys")
+        if not isinstance(keys, list) or not keys or any(not isinstance(key, str) for key in keys):
+            raise ValueError("Computer keys must be a nonempty array of strings")
+    if name == "scroll":
+        action.setdefault("scroll_x", 0)
+        action.setdefault("scroll_y", 0)
+        if any(type(action[key]) is not int for key in ("scroll_x", "scroll_y")):
+            raise ValueError("Computer scroll amounts must be integers")
+    elif name == "click":
+        button = action.setdefault("button", "left")
+        if not isinstance(button, str) or button not in {"left", "right", "middle"}:
+            raise ValueError("Unknown computer mouse button")
+    elif name == "right_click":
+        action.update(type="click", button="right")
+    elif name == "drag":
+        action = {
+            "type": "drag",
+            "path": [
+                {"x": action["start_x"], "y": action["start_y"]},
+                {"x": action["end_x"], "y": action["end_y"]},
+            ],
+        }
+    elif name == "terminate":
+        status = action.get("status", "success")
+        if not isinstance(status, str) or status not in {"success", "failure"}:
+            raise ValueError("Unknown computer termination status")
+        return make_output_text_item(f"Task complete ({status}).")
+    return {
+        "type": "computer_call",
+        "call_id": item["call_id"],
+        "action": action,
+        "status": "completed",
+        "pending_safety_checks": [],
+    }
+
+
+def _function_computer_history(messages: List[Dict[str, Any]]) -> List[Dict[str, Any]]:
+    """Serialize Cua's computer items for a standard Responses function tool."""
+    prepared = []
+    for original in messages:
+        item = deepcopy(original)
+        if item.get("type") == "computer_call":
+            arguments = dict(item["action"])
+            arguments["action"] = arguments.pop("type")
+            if arguments["action"] == "drag":
+                path = arguments.pop("path")
+                arguments.update(
+                    start_x=path[0]["x"],
+                    start_y=path[0]["y"],
+                    end_x=path[-1]["x"],
+                    end_y=path[-1]["y"],
+                )
+            prepared.append(
+                {
+                    "type": "function_call",
+                    "name": "computer",
+                    "call_id": item["call_id"],
+                    "arguments": json.dumps(arguments),
+                }
+            )
+        elif item.get("type") == "computer_call_output":
+            output = item.get("output", {})
+            image = output.get("image_url") if isinstance(output, dict) else None
+            prepared.append(
+                {
+                    "type": "function_call_output",
+                    "call_id": item["call_id"],
+                    "output": "Screenshot attached." if image else json.dumps(output),
+                }
+            )
+            if image:
+                prepared.append(
+                    {"role": "user", "content": [{"type": "input_image", "image_url": image}]}
+                )
+        else:
+            prepared.append(item)
+    return prepared
+

@@ -0,0 +1,217 @@
+"""Hermetic OpenAI Responses computer-tool interoperability regressions."""
+
+import asyncio
+import base64
+import io
+import json
+
+import pytest
+from cua_agent import ComputerAgent
+from cua_agent.computers import CustomComputerHandler
+from cua_agent.loops.openai import OpenAIComputerUseConfig, _prepare_tools_for_openai
+from PIL import Image
+
+
+def screenshot():
+    buffer = io.BytesIO()
+    Image.new("RGB", (640, 480), "black").save(buffer, format="PNG")
+    return buffer.getvalue()
+
+
+def flat_arguments(action, **active):
+    return {
+        "action": action,
+        "x": 0,
+        "y": 0,
+        "text": "",
+        "keys": [],
+        "scroll_x": 0,
+        "scroll_y": 0,
+        "button": "left",
+        "start_x": 0,
+        "start_y": 0,
+        "end_x": 0,
+        "end_y": 0,
+        "status": "success",
+        **active,
+    }
+
+
+def test_custom_dict_dimensions_are_used_in_openai_tool():
+    async def run():
+        computer = {"screenshot": screenshot, "dimensions": (640, 480), "environment": "mac"}
+        tools = await _prepare_tools_for_openai(
+            [{"type": "computer", "computer": computer}], model="openai/gpt-5.4"
+        )
+        assert "640x480" in tools[0]["description"]
+        assert "Environment: mac" in tools[0]["description"]
+
+    asyncio.run(run())
+
+
+def test_gpt54_dispatches_function_computer_and_sends_images_on_next_turn(monkeypatch):
+    calls, typed, keys, usage = [], [], [], []
+    png = screenshot()
+
+    async def responses(**kwargs):
+        calls.append(kwargs)
+        assert kwargs["model"] == "openai/gpt-5.4"
+        if len(calls) > 1:
+            history = kwargs["input"]
+            assert not any(
+                item.get("type") in {"computer_call", "computer_call_output"} for item in history
+            )
+            previous_id = f"call-{len(calls)-1}"
+            call = next(
+                item
+                for item in history
+                if item.get("type") == "function_call" and item.get("call_id") == previous_id
+            )
+            output_index = next(
+                i
+                for i, item in enumerate(history)
+                if item.get("type") == "function_call_output" and item.get("call_id") == previous_id
+            )
+            assert call["name"] == "computer"
+            assert history[output_index + 1]["content"][0]["type"] == "input_image"
+            assert history[output_index + 1]["content"][0]["image_url"].startswith(
+                "data:image/png;base64,"
+            )
+        if len(calls) == 1:
+            arguments = flat_arguments("type", text="hello Ω")
+        elif len(calls) == 2:
+            assert typed == ["hello Ω"]
+            arguments = flat_arguments("keypress", keys=["enter"])
+        else:
+            assert keys == [["enter"]]
+            return {
+                "output": [
+                    {
+                        "type": "message",
+                        "role": "assistant",
+                        "content": [{"type": "output_text", "text": "Done"}],
+                    }
+                ],
+                "usage": {"input_tokens": 11, "output_tokens": 3, "total_tokens": 14},
+            }
+        return {
+            "output": [
+                {
+                    "type": "function_call",
+                    "call_id": f"call-{len(calls)}",
+                    "name": "computer",
+                    "arguments": json.dumps(arguments),
+                }
+            ],
+            "usage": {"input_tokens": 11, "output_tokens": 3, "total_tokens": 14},
+        }
+
+    class Usage:
+        async def on_usage(self, value):
+            usage.append(value)
+
+    monkeypatch.setattr("litellm.aresponses", responses)
+
+    async def run():
+        handler = CustomComputerHandler(
+            {
+                "screenshot": lambda: png,
+                "dimensions": (640, 480),
+                "environment": "linux",
+                "type": typed.append,
+                "keypress": keys.append,
+            }
+        )
+        agent = ComputerAgent(
+            model="openai/gpt-5.4",
+            tools=[handler],
+            callbacks=[Usage()],
+            telemetry_enabled=False,
+            max_retries=0,
+            screenshot_delay=0,
+        )
+        return [
+            item
+            async for item in agent.run(
+                [
+                    {
+                        "role": "user",
+                        "content": [
+                            {
+                                "type": "input_image",
+                                "image_url": "data:image/png;base64,"
+                                + base64.b64encode(png).decode(),
+                            }
+                        ],
+                    }
+                ]
+            )
+        ]
+
+    result = asyncio.run(run())
+    assert len(calls) == 3
+    assert len(usage) == 3
+    assert all(item["input_tokens"] == 11 and item["output_tokens"] == 3 for item in usage)
+    assert result[-1]["output"][0]["content"][0]["text"] == "Done"
+
+
+def test_native_preview_and_other_function_calls_are_unchanged(monkeypatch):
+    outputs = [
+        {"type": "computer_call", "call_id": "native", "action": {"type": "screenshot"}},
+        {"type": "function_call", "name": "other", "call_id": "other", "arguments": "{}"},
+    ]
+
+    async def responses(**kwargs):
+        assert kwargs["input"] == [{"role": "user", "content": "Task"}]
+        return {"output": outputs, "usage": {}}
+
+    monkeypatch.setattr("litellm.aresponses", responses)
+
+    async def run():
+        config = OpenAIComputerUseConfig()
+        response = await config.predict_step(
+            messages=[{"role": "user", "content": "Task"}], model="openai/computer-use-preview"
+        )
+        assert response["output"] == outputs
+
+    asyncio.run(run())
+
+
+@pytest.mark.parametrize(
+    "arguments, error",
+    [
+        ("not-json", "Malformed OpenAI computer arguments"),
+        ("[]", "Computer arguments must be a JSON object"),
+        ('{"action":"unknown"}', "Unknown OpenAI computer action"),
+        ('{"action":"type","text":123}', "Computer text must be a string"),
+        ('{"action":"click","x":true,"y":1}', "Computer coordinates must be integers"),
+    ],
+)
+def test_malformed_computer_function_never_dispatches(monkeypatch, arguments, error):
+    async def responses(**kwargs):
+        return {
+            "output": [
+                {
+                    "type": "function_call",
+                    "call_id": "bad",
+                    "name": "computer",
+                    "arguments": arguments,
+                }
+            ],
+            "usage": {},
+        }
+
+    monkeypatch.setattr("litellm.aresponses", responses)
+
+    async def run():
+        handler = CustomComputerHandler({"screenshot": screenshot, "dimensions": (640, 480)})
+        config = OpenAIComputerUseConfig()
+        with pytest.raises(ValueError, match=f"^{error}$"):
+            await config.predict_step(
+                messages=[],
+                model="openai/gpt-5.4",
+                tools=[{"type": "computer", "computer": handler}],
+                computer_handler=handler,
+            )
+
+    asyncio.run(run())
